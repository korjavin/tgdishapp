# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram User ID, to be used as the admin
ADMIN_USER_ID=
# The domain for the web app, used by Caddy for HTTPS. For local dev, this can be localhost.
DOMAIN=localhost
# The database connection string.
# For SQLite, use: DATABASE_URL=sqlite:///db/duties.db
# For PostgreSQL, use: DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db/duties.db
# (For Production) The full name of the container image to be pulled from the registry.
IMAGE_NAME=ghcr.io/your-username/your-repo:latest
